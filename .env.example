# ---------------------------------------------------------------------------
# Banco de dados (Supabase / Postgres)
# ---------------------------------------------------------------------------
# Opção A (recomendada): string de conexão completa do pooler (Supavisor).
# Dashboard Supabase > Project Settings > Database > Connection pooling.
DATABASE_URL="postgresql://garimpo_app.<project-ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Opção B: o app monta a URL do pooler sozinho e testa aws-1 e aws-0.
SUPABASE_PROJECT_REF=""
SUPABASE_DB_PASSWORD=""
SUPABASE_DB_USER="garimpo_app"
SUPABASE_REGION="sa-east-1"

# Usadas apenas por scripts auxiliares e pelo painel; o app não depende delas.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Camada de ingestão
# ---------------------------------------------------------------------------
# "apify" | "direct"
SEARCH_PROVIDER="direct"

# Necessários quando SEARCH_PROVIDER=apify (e para o fallback automático do
# adapter "direct" quando ele fica obsoleto).
APIFY_TOKEN=""
APIFY_ACTOR_ID=""

# Rate limit global das chamadas à origem (req/s). Não aumentar sem motivo.
PROVIDER_MAX_RPS="1"

# ---------------------------------------------------------------------------
# Jobs agendados
# ---------------------------------------------------------------------------
# Segredo exigido pelo header Authorization das rotas de cron.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Notificações (opcional)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="Garimpo <alertas@example.com>"

# ---------------------------------------------------------------------------
# Acesso à aplicação
# ---------------------------------------------------------------------------
# Sem esta variável a aplicação recusa toda requisição (fail closed).
# Complementa — não substitui — o Vercel Authentication.
APP_ACCESS_PASSWORD=""

# Vercel Cron envia este segredo como Authorization: Bearer <CRON_SECRET>.
# Sem ele, as rotas /api/cron/* recusam toda requisição.
