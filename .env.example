# ---------------------------------------------------------------------------
# Camada de ingestão — a única configuração que o app realmente precisa
# ---------------------------------------------------------------------------
# "direct" | "apify"
SEARCH_PROVIDER="direct"

# Necessários quando SEARCH_PROVIDER=apify, e também para a queda automática
# quando o adapter "direct" fica obsoleto.
APIFY_TOKEN=""
APIFY_ACTOR_ID=""

# Ajuste fino do input do actor da Apify, em JSON. Opcional.
APIFY_INPUT_TEMPLATE=""

# Rate limit global das chamadas à origem (req/s). Não aumentar sem motivo:
# bloqueio de IP é o cenário de falha realista.
PROVIDER_MAX_RPS="1"
